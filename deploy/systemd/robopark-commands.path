[Unit]
# Application watchers run after core, not before paths.target.
DefaultDependencies=no
Requires=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target
Description=Robopark approved host commands
After=robopark.service sysinit.target

[Path]
PathExists=/var/lib/robopark/ops/inbox/approved.json
Unit=robopark-commands.service

[Install]
WantedBy=multi-user.target
