[Unit]
# Application watchers run after core, not before paths.target.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Description=Watch Robopark Telegram bot desired state
Requires=robopark.service sysinit.target
After=robopark.service sysinit.target
PartOf=robopark.service

[Path]
PathChanged=/var/lib/robopark/data/telegram-bot/enabled.json
Unit=robopark-bot.service
