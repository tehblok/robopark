[Unit]
Description=Robopark updater
After=network-online.target robopark.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
LimitNOFILE=65536
TasksMax=4096
Type=oneshot
# Prepare the exact bridge before the updater process enters its mount namespace.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create --prefix=/run/robopark-ai /etc/tmpfiles.d/robopark.conf
ExecStart=/usr/bin/python3 -I /opt/robopark/host-tools/robopark update
TimeoutStartSec=18000
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
ReadWritePaths=/var/lib/robopark /opt/robopark /etc/robopark /etc/systemd/system /etc/tmpfiles.d /var/log/robopark -/run/robopark-ai -/run/lock/robopark

[Install]
WantedBy=multi-user.target
