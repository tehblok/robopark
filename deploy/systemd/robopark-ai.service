[Unit]
Description=Robopark private Prism local inference
Requires=robopark-storage.target
After=robopark-storage.target
ConditionPathExists=/var/lib/robopark/ai/bin/llama-server
ConditionPathExists=/var/lib/robopark/ai/models/Ternary-Bonsai-2-27B-PQ2_0.gguf
ConditionPathExists=/var/lib/robopark/ai/api-key
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=robopark-ai
Group=robopark-ai
SupplementaryGroups=video render
ExecStartPre=+/usr/bin/python3 -I /opt/robopark/host-tools/robopark ai-verify
ExecStart=/var/lib/robopark/ai/bin/llama-server --model /var/lib/robopark/ai/models/Ternary-Bonsai-2-27B-PQ2_0.gguf --api-key-file /var/lib/robopark/ai/api-key --host 127.0.0.1 --port 18081 -c 8192 -np 1 -ngl 99 -fa on --jinja --reasoning auto
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/var/lib/robopark/ai
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/nvhost-gpu rw
DeviceAllow=/dev/nvhost-ctrl rw
DeviceAllow=/dev/nvhost-ctrl-gpu rw
DeviceAllow=/dev/nvhost-prof-gpu rw
DeviceAllow=/dev/nvhost-as-gpu rw
DeviceAllow=/dev/nvmap rw
UMask=0077
MemoryMax=16G
MemorySwapMax=0
TasksMax=256
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
