# Build from the immutable release root:
# docker build --target test -f deploy/Dockerfile.api-tests -t robopark-api-tests RELEASE_ROOT
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS test
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends bash git rsync \
    && rm -rf /var/lib/apt/lists/*
ARG UV_VERSION=0.11.31
ARG PIP_VERSION=26.2.1
RUN pip install --no-cache-dir --upgrade "pip==${PIP_VERSION}"

RUN pip install --no-cache-dir "uv==${UV_VERSION}"
WORKDIR /repo
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache
# Root context retains deployment scripts and fixtures used by API regressions.
# The root .dockerignore excludes secrets and runtime data.
COPY . .
RUN uv sync --directory apps/api --frozen --extra dev
RUN useradd --create-home --uid 10001 robopark \
    && chown -R robopark:robopark /repo /tmp/uv-cache
USER robopark
CMD ["sh", "scripts/verify.sh", "api"]
