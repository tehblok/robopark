#!/usr/bin/env python3
"""Entrypoint for the Robopark host utility."""

import sys
from pathlib import Path

# -I ignores PYTHONPATH and the caller's working directory; only this trusted
# launcher target contributes host modules.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "ota"))
from robopark_host.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
