# Copy to wg.env (untracked). Used by: docker compose --env-file wg.env up -d

# VPS public address — clients and the host peer connect here.
SERVERURL=203.0.113.10

SERVERPORT=51820
TZ=Europe/Moscow
PUID=1000
PGID=1000

# VPN addressing: server .1, host peer .2, operators .3+
INTERNAL_SUBNET=10.8.0.0
ALLOWEDIPS=10.8.0.0/24

# Regenerate peer list before first boot; add names for each operator device.
PEERS=host,operator1,operator2
