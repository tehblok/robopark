# Public hostname served by Caddy. Replace before deployment.
ROBOPARK_ROLE=vps
PUBLIC_HOST=robopark.example.com

# Operator-provided tunnel DNS name and port for the host-side upstream.
# Must point at the host's web container (8080), which serves the SPA and
# implements the /api prefix. Pointing at the API container (8000) serves no SPA.
TUNNEL_UPSTREAM=host.tunnel:8080
