# Copy to host.env and set HOST_ENV_FILE=./host.env when starting Compose.
ROBOPARK_ROLE=host

# Public HTTPS origin from Tuna (must match the URL mechanics open).
# Example reserved subdomain: https://robopark.<region>.tuna.am
# Example custom domain:      https://robopark.example.com
CORS_ORIGINS=https://robopark.example.tuna.am

SESSION_COOKIE_NAME=robopark_session
# SESSION_IDLE_SECONDS=259200
# SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Tuna terminates TLS — secure cookies required.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Operator self-registration gate (optional). Leave empty to disable /register.
OPERATOR_SHARED_PASSWORD=

# REQUIRED: encrypts Tracker OAuth token, Emergency cookie, and registration
# password at rest. Empty SECRET_KEY refuses secret writes (fail closed).
# Generate once and keep it out of Git:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key means re-entering secrets in /admin.
SECRET_KEY=

# Password policy for registration and admin-created accounts.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true

# Brute-force protection for /auth/login and /auth/register.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_ATTEMPTS=10

# Optional first-boot administrator. Set a strong password outside Git.
SEED_USERNAME=royal
SEED_PASSWORD=
SEED_ROLE=royal

# Never enable demo accounts on a deployed host.
DEV_SEED=false
