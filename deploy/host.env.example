# Copy to host.env and set HOST_ENV_FILE=./host.env when starting Compose.
ROBOPARK_ROLE=host

# WireGuard VPN access: use the host peer IP from deploy/vps (default 10.8.0.2).
# Add more origins if you use a hostname on the VPN (e.g. http://robopark.vpn:8080).
CORS_ORIGINS=http://10.8.0.2:8080

SESSION_COOKIE_NAME=robopark_session

# VPN is HTTP-only (no public TLS terminator). Secure cookies would never be sent.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Operator self-registration gate (optional). Leave empty to disable /register.
OPERATOR_SHARED_PASSWORD=

# REQUIRED in a deployment: encrypts the Tracker OAuth token and the Emergency
# cookie at rest, so a copy of robopark.db does not hand over working
# credentials. Generate once and keep it out of Git:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key means re-entering both secrets in /admin.
SECRET_KEY=

# Password policy for registration and admin-created accounts.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true

# Brute-force protection for /auth/login and /auth/register.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_ATTEMPTS=10

# Optional first-boot administrator. Set a strong password outside Git.
SEED_USERNAME=royal
SEED_PASSWORD=
SEED_ROLE=royal

# Never enable demo accounts on a deployed host.
DEV_SEED=false
