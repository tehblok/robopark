# Copy to host.env and set HOST_ENV_FILE=./host.env when starting Compose.
ROBOPARK_ROLE=host
CORS_ORIGINS=http://localhost:8080
SESSION_COOKIE_NAME=robopark_session
# Session cookies are HTTPS-only. Set false only for LAN-only testing over
# plain HTTP, where a Secure cookie would never be sent back.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Shared gate for operator self-registration. Unset or empty disables it.
OPERATOR_SHARED_PASSWORD=

# Optional first-boot administrator. Set a strong password outside Git.
SEED_USERNAME=royal
SEED_PASSWORD=
SEED_ROLE=royal
