# Environment for robopark-tuna.service (not committed).
# Copy to /etc/robopark/tuna.env and chmod 600.
# Tuna-native vars: TUNA_TOKEN, TUNA_SUBDOMAIN, TUNA_LOCATION, TUNA_DOMAIN
# (see https://tuna.am/docs/tunnels/http/). Set SUBDOMAIN *or* DOMAIN, not both.

# Required — agent token from https://tuna.am/ cabinet
TUNA_TOKEN=tt_replace_me

# tuna-cli on PATH, or absolute path if systemd PATH is too short
# TUNA_BIN=/usr/local/bin/tuna

# Prefer a Russian region code from `tuna http --help` / cabinet (RF ping).
# TUNA_LOCATION=

# Stable subdomain (paid). Example: https://robopark.<region>.tuna.am
# TUNA_SUBDOMAIN=robopark

# Or your own domain after DNS + LE in the Tuna cabinet:
# TUNA_DOMAIN=robopark.example.com

# Local Robopark web (Compose binds 127.0.0.1:8080). Not a Tuna-native variable.
TUNA_BIND=127.0.0.1:8080

# Optional lower edge throttle. Tuna itself caps a domain at 100 requests/s.
# Do not set 20 for 200 users: normal background traffic can exceed it.
# https://tuna.am/docs/restrictions/
# TUNA_RATE_LIMIT=100
