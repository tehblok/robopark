# API
DATABASE_URL=sqlite:///./data/robopark.db
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=robopark_session
# Idle: no authenticated request for this long → re-login (default 3 days).
SESSION_IDLE_SECONDS=259200
# Hard cap from login and Max-Age when «Запомнить меня» is checked (30 days).
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# Local development over plain http://localhost only. Deployments use
# deploy/host.env.example, which defaults to COOKIE_SECURE=true (Tuna HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Legacy fallback for POST /auth/register. Prefer /admin → «Общий пароль
# регистрации» (royal only). Unset/empty in DB and env disables registration.
OPERATOR_SHARED_PASSWORD=

# Master key encrypting the Tracker token and Emergency cookie stored in the
# database. REQUIRED before writing secrets (fail closed — no plaintext).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this key makes existing secrets unreadable — re-enter them in /admin.
SECRET_KEY=

# Password policy for registration and admin-created accounts.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true

# Brute-force protection for /auth/login and /auth/register.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_ATTEMPTS=10

# First boot only — change immediately; never commit real values
SEED_USERNAME=royal
SEED_PASSWORD=
SEED_ROLE=royal

# Local demo users + Demo park (see docs/DEV-ACCOUNTS.md). Keep false unless
# you intentionally want known demo passwords on this machine.
DEV_SEED=false

# Expose FastAPI /docs locally (never enable on a tunneled host).
OPENAPI_ENABLED=false

# Production deploy uses deploy/host.env (host-only) + Tuna tunnel —
# see deploy/README.md.
ROBOPARK_ROLE=host

# Royal snapshot/update (optional; defaults are fine).
# OPS_DIR=/data/ops
# OPS_APPLY_ROOT=/host-repo
# OPS_HOST_ENV_PATH=/host-repo/deploy/host.env
# OPS_SYNC=false

# Internal Startrek (st-api.yandex-team.ru). OAuth token is stored in admin UI /
# platform settings — not Org-Id headers (those are for cloud Tracker only).
# TRACKER_API_BASE=https://st-api.yandex-team.ru
# TRACKER_WEB_BASE=https://st.yandex-team.ru
# TRACKER_USER_AGENT=robopark-api/0.1
# TRACKER_STARTREK_PATH=/absolute/path/to/startrek_client-2.8
