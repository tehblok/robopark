# API
DATABASE_URL=sqlite:///./data/robopark.db
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=robopark_session
SESSION_TTL_SECONDS=1209600
# Local development over plain http://localhost only. Deployments use
# deploy/host.env.example, which defaults to COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Shared gate for POST /auth/register. Unset or empty disables registration.
OPERATOR_SHARED_PASSWORD=

# Master key encrypting the Tracker token and Emergency cookie stored in the
# database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty and secrets fall back to plaintext storage (a warning is logged).
# Changing this key makes existing secrets unreadable — re-enter them in /admin.
SECRET_KEY=

# Password policy for registration and admin-created accounts.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true

# Brute-force protection for /auth/login and /auth/register.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_ATTEMPTS=10

# First boot only — change immediately; never commit real values
SEED_USERNAME=royal
SEED_PASSWORD=
SEED_ROLE=royal

# Production deploy uses deploy/host.env (host-only). VPS runs WireGuard only —
# see deploy/vps/README.md.
ROBOPARK_ROLE=host

# Internal Startrek (st-api.yandex-team.ru). OAuth token is stored in admin UI /
# platform settings — not Org-Id headers (those are for cloud Tracker only).
# TRACKER_API_BASE=https://st-api.yandex-team.ru
# TRACKER_WEB_BASE=https://st.yandex-team.ru
# TRACKER_USER_AGENT=robopark-api/0.1
# TRACKER_STARTREK_PATH=/absolute/path/to/startrek_client-2.8
