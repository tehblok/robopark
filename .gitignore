# Secrets & env
# Every *.env variant is operator-owned and untracked (deploy/host.env,
# /etc/robopark/tuna.env, apps/api/.env); only *.env.example are committed.
.env
.env.*
*.env
!*.env.example

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / frontend
node_modules/
.next/
.nuxt/
dist/
coverage/

# Local runtime / data
data/
!apps/api/data/
apps/api/data/*
!apps/api/data/emergency_sections.json
apps/api/data/ops/
apps/api/data/report-attachments/
apps/api/logs/
*.log
*.sqlite
*.db
*.db-shm
*.db-wal

# Vendored Startrek client (local copy; same as bot_otchet layout)
startrek_client-2.8/

# Local git worktrees
.worktrees/

# Agent / local SDD artifacts (not part of the product)
.superpowers/
docs/superpowers/
.skaroignore

# Local audit evidence, VM disks, dependency caches and design captures
/output/
/.pnpm-store/
/.serena/
/apps/web/tmp/
/docs/design/mockups/
/docs/handoffs/

# Offline release-signing material
.release-secrets/

# Generated signed release bundles
/artifacts/
/robopark-release*.zip*
/robopark-installer*.tar.gz*

# Local capacity-test session credentials
capacity-private*.json
