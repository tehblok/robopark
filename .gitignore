# Secrets & env
# Every *.env variant is operator-owned and untracked (deploy/host.env,
# /etc/robopark/tuna.env, apps/api/.env); only *.env.example are committed.
.env
.env.*
*.env
!*.env.example

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node / frontend
node_modules/
.next/
.nuxt/
dist/
coverage/

# Local runtime / data
data/
!apps/api/data/
!apps/api/data/emergency_sections.json
apps/api/data/ops/
apps/api/data/report-attachments/
apps/api/logs/
*.log
*.sqlite
*.db
*.db-shm
*.db-wal

# Vendored Startrek client (local copy; same as bot_otchet layout)
startrek_client-2.8/

# Local git worktrees
.worktrees/

