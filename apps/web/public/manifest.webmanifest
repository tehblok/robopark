{
  "id": "/",
  "name": "Работа",
  "short_name": "Работа",
  "description": "Управление роботами и задачами парка",
  "lang": "ru",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#243344",
  "theme_color": "#243344",
  "icons": [
    { "src": "/pwa-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Мои задачи", "short_name": "Мои задачи", "url": "/work?view=mine" },
    { "name": "Сканировать робота", "short_name": "Сканер", "url": "/robots?scan=1" },
    { "name": "Склад", "short_name": "Склад", "url": "/inventory" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photo", "accept": ["image/*"] }]
    }
  }
}
